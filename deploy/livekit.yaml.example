# LiveKit Server configuration for TS3Stream.
# Copy to /etc/ts3stream/livekit.yaml and replace the placeholders.
#
# Signaling is terminated by Caddy on 443. LiveKit itself listens on localhost.
# TURN/TLS uses the certificate below, so clients behind strict firewalls can
# still connect over TCP 5349.

port: 7880
bind_addresses:
  - 127.0.0.1

rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: true
  # node_ip: 203.0.113.10

turn:
  enabled: true
  domain: turn.example.com
  tls_port: 5349
  udp_port: 3478
  cert_file: /etc/letsencrypt/live/turn.example.com/fullchain.pem
  key_file: /etc/letsencrypt/live/turn.example.com/privkey.pem

keys:
  # Replace both values; they must match LIVEKIT_API_KEY/SECRET for control.
  devkey: replace-with-a-long-random-secret

logging:
  level: info
