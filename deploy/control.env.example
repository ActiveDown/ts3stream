# Environment for ts3stream-control. Copy to /etc/ts3stream/control.env.
TS3STREAM_CONTROL_ADDR=127.0.0.1:8081
# Matching WebRTC video buffer and client audio compensation. Viewers need 0.3.8+.
# Applies to newly created rooms; 0 disables buffering. Valid: 0..5000, steps of 10.
TS3STREAM_PLAYOUT_DELAY_MS=2000
# Shared secret expected in X-TS3Stream-Key. Leave empty only for local tests.
TS3STREAM_CLIENT_KEY=replace-with-a-random-client-key

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-the-same-secret-as-livekit.yaml
# Public URL returned to the TS3 plugin (through Caddy).
LIVEKIT_URL=wss://stream.example.com
