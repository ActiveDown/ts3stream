index 0000000..1cb1f4e
--- /dev/null
+++ b/pkg/sfu/buffer/server_av_buffer_test.go
@@ -0,0 +1,214 @@
+package buffer
+
+import (
+	_ "embed"
+	"encoding/json"
+	"testing"
+
+	"github.com/livekit/livekit-server/pkg/sfu/testutils/rtptest"
+	"github.com/pion/rtp"
+	"github.com/pion/transport/v4/packetio"
+	"github.com/pion/webrtc/v4"
+	"github.com/stretchr/testify/require"
+)
+
+func TestServerAVBufferBoundsMetadataWhileForwarderWaits(t *testing.T) {
+	factory := NewFactoryOfBufferFactory(500, 200).CreateBufferFactory()
+	primary := factory.GetOrNew(packetio.RTPBufferPacket, fecTestMediaSSRC).(*Buffer)
+	defer primary.Close()
+	bindFECTestBuffer(t, primary)
+	packets := rtptest.GenerateVP8Packets(100, 5000, uint8(vp8Codec.PayloadType), fecTestMediaSSRC)
+	for i := range packets {
+		writePacket(t, primary, &packets[i])
+	}
+	primary.Lock()
+	defer primary.Unlock()
+	require.Greater(t, primary.extPackets.Len(), 0)
+	require.LessOrEqual(t, primary.extPackets.Len(), primary.bucket.Capacity())
+}
+
+// A delayed forwarder must retain both packet metadata and the RTP bytes, even
+// when no bitrate was advertised and the adaptive bucket has not grown yet.
+func TestServerAVBufferRetainsDelayedPackets(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		codec webrtc.RTPCodecParameters
+		count int
+	}{
+		{"audio", opusCodec, 500},
+		{"video", vp8Codec, 5000},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			primary := NewBuffer(fecTestMediaSSRC, 16384, 2048)
+			defer primary.Close()
+			primary.EnableServerAVBuffering()
+			require.NoError(t, primary.Bind(webrtc.RTPParameters{
+				Codecs: []webrtc.RTPCodecParameters{tc.codec},
+			}, tc.codec.RTPCodecCapability, 0))
+			packets := rtptest.GenerateVP8Packets(100, tc.count, uint8(tc.codec.PayloadType), fecTestMediaSSRC)
+			for i := range packets {
+				writePacket(t, primary, &packets[i])
+			}
+			primary.RLock()
+			queued := primary.extPackets.Len()
+			primary.RUnlock()
+			require.Equal(t, tc.count, queued, "packets discarded during server holdback")
+			var raw [1500]byte
+			for i := range packets {
+				ep, err := primary.ReadExtended(raw[:])
+				require.NoError(t, err)
+				require.NotNil(t, ep)
+				require.Equal(t, packets[i].SequenceNumber, ep.Packet.SequenceNumber)
+				var cached [1500]byte
+				n, err := primary.GetPacket(cached[:], ep.ExtSequenceNumber)
+				require.NoError(t, err)
+				var parsed rtp.Packet
+				require.NoError(t, parsed.Unmarshal(cached[:n]))
+				require.Equal(t, packets[i].SequenceNumber, parsed.SequenceNumber)
+				require.Equal(t, packets[i].Payload, parsed.Payload)
+				ReleaseExtPacket(ep)
+			}
+		})
+	}
+}
+
+func TestServerAVBufferInitialCapacityAndBound(t *testing.T) {
+	for _, serverMode := range []bool{false, true} {
+		for _, codec := range []webrtc.RTPCodecParameters{opusCodec, vp8Codec} {
+			primary := NewBuffer(fecTestMediaSSRC, 500, 200)
+			if serverMode {
+				primary.EnableServerAVBuffering()
+			}
+			require.NoError(t, primary.Bind(webrtc.RTPParameters{
+				Codecs: []webrtc.RTPCodecParameters{codec},
+			}, codec.RTPCodecCapability, 0))
+			capacity := InitPacketBufferSizeVideo
+			if codec.MimeType == opusCodec.MimeType {
+				capacity = InitPacketBufferSizeAudio
+			}
+			if serverMode {
+				capacity = ServerAVPacketBufferSizeVideo
+				if codec.MimeType == opusCodec.MimeType {
+					capacity = ServerAVPacketBufferSizeAudio
+				}
+			}
+			require.Equal(t, capacity, primary.bucket.Capacity())
+			packets := rtptest.GenerateVP8Packets(100, capacity+100, uint8(codec.PayloadType), fecTestMediaSSRC)
+			for i := range packets {
+				writePacket(t, primary, &packets[i])
+			}
+			primary.RLock()
+			queued, actualCapacity := primary.extPackets.Len(), primary.bucket.Capacity()
+			primary.RUnlock()
+			require.LessOrEqual(t, queued, capacity)
+			require.Equal(t, capacity, actualCapacity)
+			primary.Close()
+		}
+	}
+}
+
+func TestServerAVBufferRepairsArrivalOrderAcrossRollover(t *testing.T) {
+	primary := NewBuffer(fecTestMediaSSRC, 16384, 2048)
+	defer primary.Close()
+	primary.EnableServerAVBuffering()
+	bindFECTestBuffer(t, primary)
+	packets := rtptest.GenerateVP8Packets(65534, 4, uint8(vp8Codec.PayloadType), fecTestMediaSSRC)
+	for i := range packets {
+		packets[i].Timestamp = 90000 + uint32(i)*3000
+	}
+	for _, i := range []int{0, 2, 3, 1} {
+		writePacket(t, primary, &packets[i])
+	}
+	require.Equal(t, len(packets), primary.extPackets.Len())
+	var raw [1500]byte
+	for i := range packets {
+		ep, err := primary.ReadExtended(raw[:])
+		require.NoError(t, err)
+		require.Equal(t, packets[i].SequenceNumber, ep.Packet.SequenceNumber, "holdback must repair arrival order, not replay network jitter")
+		ReleaseExtPacket(ep)
+	}
+}
+
+func TestServerAVBufferRechecksRepairsArrivingDuringWait(t *testing.T) {
+	primary := NewBuffer(fecTestMediaSSRC, 16384, 2048)
+	defer primary.Close()
+	primary.EnableServerAVBuffering()
+	bindFECTestBuffer(t, primary)
+	packets := rtptest.GenerateVP8Packets(100, 4, uint8(vp8Codec.PayloadType), fecTestMediaSSRC)
+	writePacket(t, primary, &packets[0])
+	writePacket(t, primary, &packets[2])
+	var raw [1500]byte
+	first, err := primary.ReadExtended(raw[:])
+	require.NoError(t, err)
+	ReleaseExtPacket(first)
+	held, err := primary.ReadExtended(raw[:])
+	require.NoError(t, err)
+	// Packet 101 arrives while the forwarder holds 102 waiting for its deadline.
+	writePacket(t, primary, &packets[3])
+	writePacket(t, primary, &packets[1])
+	repaired := primary.ReorderExtended(held, raw[:])
+	require.NotNil(t, repaired)
+	require.Equal(t, uint16(101), repaired.Packet.SequenceNumber)
+	require.Equal(t, packets[1].Payload, repaired.Packet.Payload)
+	ReleaseExtPacket(repaired)
+	for i := 2; i < 4; i++ {
+		require.Positive(t, primary.extPackets.Len())
+		ep, err := primary.ReadExtended(raw[:])
+		require.NoError(t, err)
+		require.Equal(t, packets[i].SequenceNumber, ep.Packet.SequenceNumber)
+		require.Equal(t, packets[i].Payload, ep.Packet.Payload, "held packet bytes must survive shared scratch-buffer reuse")
+		ReleaseExtPacket(ep)
+	}
+	require.Zero(t, primary.extPackets.Len())
+}
+
+func TestServerAVOrdinaryBufferRemainsFIFO(t *testing.T) {
+	primary := NewBuffer(fecTestMediaSSRC, 500, 200)
+	defer primary.Close()
+	bindFECTestBuffer(t, primary)
+	packets := rtptest.GenerateVP8Packets(100, 4, uint8(vp8Codec.PayloadType), fecTestMediaSSRC)
+	order := []int{0, 2, 3, 1}
+	for _, i := range order {
+		writePacket(t, primary, &packets[i])
+	}
+	require.Equal(t, len(packets), primary.extPackets.Len())
+	var raw [1500]byte
+	for _, i := range order {
+		ep, err := primary.ReadExtended(raw[:])
+		require.NoError(t, err)
+		require.Equal(t, packets[i].SequenceNumber, ep.Packet.SequenceNumber)
+		ReleaseExtPacket(ep)
+	}
+}
+
+//go:embed testdata/server_av_reorder.json
+var serverAVReorderTrace []byte
+
+func TestServerAVBufferReplaysCapturedLateFrameTail(t *testing.T) {
+	var fixture struct {
+		Packets [][3]uint32 `json:"packets"`
+	}
+	require.NoError(t, json.Unmarshal(serverAVReorderTrace, &fixture))
+	require.Len(t, fixture.Packets, 651)
+	primary := NewBuffer(fecTestMediaSSRC, 16384, 2048)
+	defer primary.Close()
+	primary.EnableServerAVBuffering()
+	bindFECTestBuffer(t, primary)
+	packets := rtptest.GenerateVP8Packets(100, len(fixture.Packets), uint8(vp8Codec.PayloadType), fecTestMediaSSRC)
+	for _, row := range fixture.Packets {
+		packets[row[0]].Timestamp = 90000 + row[1]
+		writePacket(t, primary, &packets[row[0]])
+	}
+	require.Equal(t, len(packets), primary.extPackets.Len())
+	var raw [1500]byte
+	var previousTimestamp uint32
+	for i := range packets {
+		ep, err := primary.ReadExtended(raw[:])
+		require.NoError(t, err)
+		require.Equal(t, packets[i].SequenceNumber, ep.Packet.SequenceNumber)
+		require.GreaterOrEqual(t, ep.Packet.Timestamp, previousTimestamp, "do not interrupt an earlier frame with future frames")
+		require.Equal(t, packets[i].Payload, ep.Packet.Payload)
+		previousTimestamp = ep.Packet.Timestamp
+		ReleaseExtPacket(ep)
+	}
+}
