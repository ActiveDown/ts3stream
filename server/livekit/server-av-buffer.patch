@@ -0,0 +1,88 @@
+// Copyright 2026 TS3Stream contributors. Licensed under Apache-2.0.
+package sfu
+
+import (
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/livekit/mediatransportutil"
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/protocol/utils/mono"
+)
+
+const ServerAVBufferPrefix = "ts3stream-server-av-v1:"
+
+// ServerAVDelay is deliberately a different contract from client playout delay.
+// An ordinary LiveKit room and a legacy TS3Stream room remain untouched.
+func ServerAVDelay(metadata string) time.Duration {
+	if !strings.HasPrefix(metadata, ServerAVBufferPrefix) {
+		return 0
+	}
+	value := strings.TrimPrefix(metadata, ServerAVBufferPrefix)
+	ms, err := strconv.Atoi(value)
+	if err != nil || ms < 10 || ms > 5000 || ms%10 != 0 || strconv.Itoa(ms) != value {
+		return 0
+	}
+	return time.Duration(ms) * time.Millisecond
+}
+
+// Cancelable absolute wait shared by the production RTP forwarder and tests.
+// Re-read SR during initial fill, since the first report can arrive after RTP.
+func (c *ServerAVClock) Wait(arrival int64, timestamp, rate uint32,
+	report func() *livekit.RTCPSenderReportState, done <-chan struct{}, valid func() bool, timer *time.Timer) (int64, bool) {
+	for valid() {
+		due := c.Deadline(arrival, timestamp, rate, report())
+		wait := time.Duration(due - mono.UnixNano())
+		if wait <= 0 {
+			return due, true
+		}
+		timer.Reset(min(wait, 50*time.Millisecond))
+		select {
+		case <-done:
+			return 0, false
+		case <-timer.C:
+		}
+	}
+	return 0, false
+}
+
+// One shared mapping per publisher, not per track or subscriber. RTCP SR maps
+// 48 kHz audio and 90 kHz video onto the SAME sender NTP timeline. Deadlines
+// are absolute server monotonic timestamps; no sleep(delay) per packet and no
+// cumulative drift. Until the first SR, arrival-time delay is the fallback.
+type ServerAVClock struct {
+	Delay    time.Duration
+	mu       sync.Mutex
+	anchored bool
+	offset   int64
+}
+
+func (c *ServerAVClock) Deadline(arrival int64, timestamp uint32, rate uint32, sr *livekit.RTCPSenderReportState) int64 {
+	fallback := arrival + int64(c.Delay)
+	if sr == nil || sr.NtpTimestamp == 0 || rate == 0 {
+		return fallback
+	}
+	// Signed subtraction handles 32-bit RTP rollover without changing epochs.
+	ticks := int64(int32(timestamp - sr.RtpTimestamp))
+	if ticks > int64(rate)*30 || ticks < -int64(rate)*30 {
+		return fallback
+	}
+	capture := mediatransportutil.NtpTime(sr.NtpTimestamp).Time().UnixNano() + ticks*int64(time.Second)/int64(rate)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.anchored {
+		c.offset = arrival - capture
+		c.anchored = true
+	}
+	due := capture + c.offset + int64(c.Delay)
+	// A publisher clock discontinuity must never pin a forwarder indefinitely.
+	// Reset the shared mapping, so both tracks recover together rather than
+	// accumulating independent offsets. Normal uplink jitter spends the buffer.
+	if due > fallback+int64(time.Second) || due < arrival-int64(5*time.Second) {
+		c.offset = arrival - capture
+		return fallback
+	}
+	return due
+}
