index 0000000..c2651f1
--- /dev/null
+++ b/pkg/sfu/buffer/server_av_packet_queue.go
@@ -0,0 +1,103 @@
+// Copyright 2026 TS3Stream contributors. Licensed under Apache-2.0.
+package buffer
+
+import (
+	"container/heap"
+
+	"github.com/gammazero/deque"
+)
+
+// Ordinary tracks remain FIFO. Delayed tracks use extended sequence numbers,
+// so repairs arriving during holdback are released before subsequent packets.
+// BufferBase's lock and bucket-capacity bound cover both queue implementations.
+type extPacketQueue struct {
+	deque.Deque[*ExtPacket]
+	ordered bool
+	packets serverAVPacketHeap
+}
+
+type serverAVPacketHeap []*ExtPacket
+
+func (h serverAVPacketHeap) Len() int { return len(h) }
+func (h serverAVPacketHeap) Less(i, j int) bool {
+	return h[i].ExtSequenceNumber < h[j].ExtSequenceNumber
+}
+func (h serverAVPacketHeap) Swap(i, j int) { h[i], h[j] = h[j], h[i] }
+func (h *serverAVPacketHeap) Push(v any)   { *h = append(*h, v.(*ExtPacket)) }
+func (h *serverAVPacketHeap) Pop() any {
+	old := *h
+	p := old[len(old)-1]
+	old[len(old)-1] = nil
+	*h = old[:len(old)-1]
+	return p
+}
+
+func (q *extPacketQueue) enableOrdering() {
+	if q.ordered {
+		return
+	}
+	q.packets = make(serverAVPacketHeap, 0, max(128, q.Deque.Len()))
+	for q.Deque.Len() > 0 {
+		q.packets = append(q.packets, q.Deque.PopFront())
+	}
+	heap.Init(&q.packets)
+	q.ordered = true
+}
+
+func (q *extPacketQueue) Len() int {
+	if q.ordered {
+		return len(q.packets)
+	}
+	return q.Deque.Len()
+}
+
+func (q *extPacketQueue) PushBack(p *ExtPacket) {
+	if q.ordered {
+		heap.Push(&q.packets, p)
+		return
+	}
+	q.Deque.PushBack(p)
+}
+
+func (q *extPacketQueue) PopFront() *ExtPacket {
+	if q.ordered {
+		return heap.Pop(&q.packets).(*ExtPacket)
+	}
+	return q.Deque.PopFront()
+}
+
+func (q *extPacketQueue) Front() *ExtPacket {
+	if q.ordered {
+		return q.packets[0]
+	}
+	return q.Deque.Front()
+}
+
+func (q *extPacketQueue) Clear() {
+	q.Deque.Clear()
+	clear(q.packets)
+	q.packets = q.packets[:0]
+}
+
+// ReorderExtended rechecks packets which arrived while the forwarder waited.
+// Ownership of held is transferred back to the queue if an earlier packet is
+// returned; its bytes are reloaded from the bucket on its next dequeue. The
+// caller must re-evaluate the returned packet's deadline and release only that
+// packet. A nil result means the bucket no longer retained any candidate.
+func (b *BufferBase) ReorderExtended(held *ExtPacket, raw []byte) *ExtPacket {
+	b.Lock()
+	defer b.Unlock()
+	if !b.serverAVBuffering || b.isClosed.Load() || b.extPackets.Len() == 0 ||
+		b.extPackets.Front().ExtSequenceNumber >= held.ExtSequenceNumber {
+		return held
+	}
+	b.extPackets.PushBack(held)
+	for b.extPackets.Len() > 0 {
+		p := b.extPackets.PopFront()
+		if patched := b.patchExtPacket(p, raw); patched != nil {
+			return patched
+		}
+		ReleaseExtPacket(p)
+	}
+	return nil
+}
