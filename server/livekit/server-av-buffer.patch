index 0000000..cadfe1c
--- /dev/null
+++ b/pkg/sfu/server_av_buffer_test.go
@@ -0,0 +1,71 @@
+package sfu
+
+import (
+	"testing"
+	"time"
+
+	"github.com/livekit/mediatransportutil"
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/protocol/utils/mono"
+	"github.com/stretchr/testify/require"
+)
+
+func TestServerAVContract(t *testing.T) {
+	require.Equal(t, 2*time.Second, ServerAVDelay("ts3stream-server-av-v1:2000"))
+	for _, value := range []string{"", "ts3stream-av-delay-v1:2000", "ts3stream-server-av-v1:2001",
+		"ts3stream-server-av-v1:5001", "ts3stream-server-av-v1:02000", "ts3stream-server-av-v1:-10"} {
+		require.Zero(t, ServerAVDelay(value), value)
+	}
+}
+
+func TestServerAVWaitDeadlineAndCancellation(t *testing.T) {
+	timer := time.NewTimer(time.Hour)
+	timer.Stop()
+	defer timer.Stop()
+	done := make(chan struct{})
+	noReport := func() *livekit.RTCPSenderReportState { return nil }
+	c := &ServerAVClock{Delay: 30 * time.Millisecond}
+	start := mono.UnixNano()
+	due, ok := c.Wait(start, 0, 48000, noReport, done, func() bool { return true }, timer)
+	require.True(t, ok)
+	require.Equal(t, start+int64(c.Delay), due)
+	require.GreaterOrEqual(t, mono.UnixNano(), due, "never forward before deadline")
+	c.Delay = 5 * time.Second
+	close(done)
+	start = mono.UnixNano()
+	_, ok = c.Wait(start, 0, 48000, noReport, done, func() bool { return true }, timer)
+	require.False(t, ok)
+	require.Less(t, mono.UnixNano()-start, int64(100*time.Millisecond), "close interrupts buffer filling")
+	_, ok = c.Wait(start, 0, 48000, noReport, nil, func() bool { return false }, timer)
+	require.False(t, ok, "restarted stream cannot forward an old generation")
+}
+
+func TestServerAVSharedClockLongRunAndRollover(t *testing.T) {
+	c := &ServerAVClock{Delay: 2 * time.Second}
+	start := time.Unix(1800000000, 0)
+	// Different RTP rates, offsets, and wraparound; same capture clock.
+	audioBase, videoBase := uint32(0xfffff000), uint32(0xffff0000)
+	for ms := int64(0); ms <= 1800000; ms += 20 {
+		capture := start.Add(time.Duration(ms) * time.Millisecond)
+		srTime := capture.Truncate(time.Second)
+		srMs := srTime.Sub(start).Milliseconds()
+		audioSR := &livekit.RTCPSenderReportState{NtpTimestamp: uint64(mediatransportutil.ToNtpTime(srTime)), RtpTimestamp: audioBase + uint32(srMs*48)}
+		videoSR := &livekit.RTCPSenderReportState{NtpTimestamp: audioSR.NtpTimestamp, RtpTimestamp: videoBase + uint32(srMs*90)}
+		// Sender wall clock is arbitrarily offset from server; network latency varies.
+		arrival := capture.UnixNano() + int64(7*time.Hour) + int64(20*time.Millisecond)
+		audioDue := c.Deadline(arrival, audioBase+uint32(ms*48), 48000, audioSR)
+		videoDue := c.Deadline(arrival+int64(time.Duration(ms%800)*time.Millisecond), videoBase+uint32(ms*90), 90000, videoSR)
+		require.Equal(t, audioDue, videoDue, "A/V capture instant must have the same deadline")
+		require.Equal(t, arrival+int64(2*time.Second), audioDue, "absolute schedule must not drift")
+	}
+}
+
+func TestServerAVMissingReportsAndClockDiscontinuity(t *testing.T) {
+	c := &ServerAVClock{Delay: 2 * time.Second}
+	now := time.Unix(1800000000, 0)
+	require.Equal(t, now.UnixNano()+int64(2*time.Second), c.Deadline(now.UnixNano(), 123, 48000, nil))
+	sr := &livekit.RTCPSenderReportState{NtpTimestamp: uint64(mediatransportutil.ToNtpTime(now)), RtpTimestamp: 123}
+	require.Equal(t, now.UnixNano()+int64(2*time.Second), c.Deadline(now.UnixNano(), 123, 48000, sr))
+	sr.NtpTimestamp = uint64(mediatransportutil.ToNtpTime(now.Add(time.Hour)))
+	require.Equal(t, now.UnixNano()+int64(2*time.Second), c.Deadline(now.UnixNano(), 123, 48000, sr), "clock jump cannot create an hour-long queue")
+}
